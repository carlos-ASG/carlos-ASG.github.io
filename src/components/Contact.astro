---

<section class="contact section" id="contacto">
	<div class="container">
		<h2>Let's talk about your project</h2>
		<p class="contact-intro">
			I'm available for new projects and always open to interesting collaborations. Tell me about your idea and let's find the best technological solution together.
		</p>

		<div class="contact-content">
			<div class="contact-info">
				<h3>Contact Information</h3>
				<div class="contact-methods">
					<div class="contact-method">
						<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg" alt="Email" class="method-icon" />
						<div>
							<h4>Email</h4>
							<a href="mailto:devcarsan@gmail.com">devcarsan@gmail.com</a>
						</div>
					</div>

					<div class="contact-method">
						<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linkedin/linkedin-original.svg" alt="LinkedIn" class="method-icon" />
						<div>
							<h4>LinkedIn</h4>
							<a href="https://www.linkedin.com/in/carlos-alberto-sandoval-guardado-496091398" target="_blank" rel="noopener noreferrer">
								www.linkedin.com/in/carlos-alberto-sandoval-guardado-496091398
							</a>
						</div>
					</div>

					<div class="contact-method">
						<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg" alt="GitHub" class="method-icon" />
						<div>
							<h4>GitHub</h4>
							<a href="https://github.com/carlos-ASG" target="_blank" rel="noopener noreferrer">
								github.com/carlos-ASG
							</a>
						</div>
					</div>

					<div class="contact-method">
						<img src="https://cdn.simpleicons.org/whatsapp/25D366" alt="WhatsApp" class="method-icon" />
						<div>
							<h4>WhatsApp</h4>
							<a href="https://wa.me/523113001151">+52 (311) 300-1151</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		background: var(--color-bg-alt);
	}

	.contact h2 {
		text-align: center;
		margin-bottom: 1rem;
	}

	.contact-intro {
		text-align: center;
		font-size: 1.1rem;
		max-width: 700px;
		margin: 0 auto 4rem;
		color: var(--color-text-light);
	}

	.contact-content {
		max-width: 600px;
		margin: 0 auto;
	}

	.contact-info h3 {
		color: var(--color-text);
		margin-bottom: 2rem;
		text-align: center;
	}

	.contact-methods {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		align-items: center;
	}

	.contact-method {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		justify-content: center;
		width: 100%;
		max-width: 400px;
	}

	.method-icon {
		width: 2.5rem;
		height: 2.5rem;
		flex-shrink: 0;
		margin-top: 0.25rem;
	}

	.contact-method > div {
		flex: 1;
	}

	.contact-method h4 {
		color: var(--color-text);
		font-size: 1rem;
		margin-bottom: 0.25rem;
	}

	.contact-method a {
		color: var(--color-text-light);
		font-size: 0.95rem;
		word-break: break-all;
	}

	.contact-method a:hover {
		color: var(--color-primary);
	}
</style>
