---
---

<section class="services section" id="servicios">
	<div class="container">
		<h2>Software Development Services</h2>
		<div class="services-grid">
			<div class="service-card">
				<div class="service-icon">
					<img src="https://api.iconify.design/mdi/cellphone-link.svg?color=%233b82f6" alt="Mobile Apps" />
				</div>
				<h3>Cross-Platform Mobile Applications</h3>
				<p>
					I create native mobile applications for iOS and Android using Flutter, ensuring a smooth user experience, attractive interfaces, and optimal performance. From e-commerce apps to business management platforms.
				</p>
				<div class="service-stack">
					<span class="tech-badge">Flutter</span>
					<span class="tech-badge">PostgreSQL</span>
					<span class="tech-badge">API REST</span>
				</div>
			</div>

			<div class="service-card">
				<div class="service-icon">
					<img src="https://api.iconify.design/mdi/monitor-dashboard.svg?color=%233b82f6" alt="Web Platforms" />
				</div>
				<h3>Modern and Responsive Web Platforms</h3>
				<p>
					I develop modern websites and web applications using technologies like Django and .NET. From conversion-optimized landing pages to complex dashboards and business management systems.
				</p>
				<div class="service-stack">
					<span class="tech-badge">Django</span>
					<span class="tech-badge">.NET</span>
					<span class="tech-badge">HTML/CSS</span>
				</div>
			</div>

			<div class="service-card">
				<div class="service-icon">
					<img src="https://api.iconify.design/mdi/server-network.svg?color=%233b82f6" alt="Backend Architecture" />
				</div>
				<h3>Robust and Scalable Backend Architecture</h3>
				<p>
					I design and implement secure and efficient RESTful APIs and backend services with Python/Django and C#/.NET. Optimized databases, authentication, external service integration, and architectures that grow with your business.
				</p>
				<div class="service-stack">
					<span class="tech-badge">Python</span>
					<span class="tech-badge">Django</span>
					<span class="tech-badge">C#</span>
					<span class="tech-badge">.NET</span>
					<span class="tech-badge">PostgreSQL</span>
				</div>
			</div>

			<div class="service-card">
				<div class="service-icon">
					<img src="https://api.iconify.design/mdi/lightbulb-on-outline.svg?color=%233b82f6" alt="Technical Consulting" />
				</div>
				<h3>Technical Consulting and Custom Development</h3>
				<p>
					Do you have a specific technical challenge? I offer consulting to help you choose the best technologies, optimize existing systems, or plan the architecture of your next project.
				</p>
				<div class="service-stack">
					<span class="tech-badge">Consulting</span>
					<span class="tech-badge">Architecture</span>
					<span class="tech-badge">Optimization</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.services {
		background: linear-gradient(180deg, white 0%, var(--color-bg-alt) 100%);
	}

	.services h2 {
		text-align: center;
		margin-bottom: 3rem;
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}

	.service-card {
		background: white;
		padding: 2.5rem;
		border-radius: 12px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
		transition: all 0.3s ease;
		border: 1px solid var(--color-border);
		display: flex;
		flex-direction: column;
	}

	.service-card:hover {
		transform: translateY(-10px);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
		border-color: var(--color-primary);
	}

	.service-icon {
		display: flex;
		justify-content: center;
		align-items: center;
		margin-bottom: 1.5rem;
	}

	.service-icon img {
		width: 64px;
		height: 64px;
		object-fit: contain;
	}

	.service-card h3 {
		color: var(--color-text);
		margin-bottom: 1rem;
		font-size: 1.35rem;
	}

	.service-card p {
		flex-grow: 1;
		line-height: 1.7;
		margin-bottom: 1.5rem;
	}

	.service-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: auto;
	}

	.tech-badge {
		display: inline-block;
		padding: 0.4rem 0.8rem;
		background: var(--color-bg-alt);
		color: var(--color-primary);
		border-radius: 6px;
		font-size: 0.85rem;
		font-weight: 600;
		border: 1px solid var(--color-primary);
	}

	@media (max-width: 768px) {
		.services-grid {
			grid-template-columns: 1fr;
		}

		.service-card {
			padding: 2rem;
		}
	}
</style>
